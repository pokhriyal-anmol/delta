# Copy to `keystore.properties` (gitignored) and fill in with YOUR values after
# generating the keystore. Never commit the real file or the .jks.
#
#   keytool -genkey -v -keystore ~/f1-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias f1
#
storeFile=/path/to/f1-release.jks
storePassword=CHANGE_ME
keyAlias=f1
keyPassword=CHANGE_ME
