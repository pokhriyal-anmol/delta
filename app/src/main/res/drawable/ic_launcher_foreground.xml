<?xml version="1.0" encoding="utf-8"?>
<!--
  Delta foreground: a racing line through a chicane with a red apex.
  Drawn from plain geometry, no F1, team or tyre marks. 108x108 canvas, 21..87 is the
  always-visible zone; this spans 23.5..85.5 x and 22.5..85.5 y, so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M27,82 C27,58 40,56 54,54 C70,52 82,50 82,26"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- apex halo -->
    <path
        android:pathData="M54,41.5 A12.5,12.5 0 1,0 54,66.5 A12.5,12.5 0 1,0 54,41.5 Z"
        android:strokeColor="#4DD71921"
        android:strokeWidth="2" />

    <!-- apex -->
    <path
        android:pathData="M54,46 A8,8 0 1,0 54,62 A8,8 0 1,0 54,46 Z"
        android:fillColor="#FFD71921" />
</vector>
